@using DasBlog.Services.ActivityLogs
@using DasBlog.Core.Common;
@using DasBlog.Web.Services.Interfaces

@model System.Collections.Generic.List<EventDataDisplayItem>
@inject IStaticPageContentSanitizer HtmlSanitizer

@{
    ViewBag.Title = "Activity Report";
}

@functions
{

    string SelectEventRowStyle(EventDataDisplayItem eddi)
    {
        switch (eddi.EventCode)
        {
            case EventCodes.Error:
            case EventCodes.PingbackServerError:
            case EventCodes.PingWeblogsError:
            case EventCodes.Pop3ServerError:
            case EventCodes.SmtpError:
                return "dbc-activity-rable-row-error";
            case EventCodes.SecurityFailure:
                return "dbc-activity-table-row-security-failure";
            case EventCodes.TrackbackBlocked:
            case EventCodes.ReferralBlocked:
            case EventCodes.ItemReferralBlocked:
            case EventCodes.CommentBlocked:
            case EventCodes.PingbackBlocked:
                return "dbc-activity-table-row-blocked";
            default:
                return string.Empty;
        }
    }

}

<section class="blog-activity">
    <header class="blog-admin-heading">
        <p class="eyebrow">Administration / Diagnostics</p>
        <h1>@ViewBag.Title</h1>
    </header>

    <form asp-controller="Activity" asp-action="EventsByQuery" method="get" class="blog-activity__toolbar">
        <label for="date">Activity date</label>
        <input type="date" name="date" id="date" value="@ViewBag.Date" />
        <button type="submit">View date</button>
        <nav class="blog-activity__dates" aria-label="Activity dates">
            <a asp-controller="Activity" asp-action="EventsByDate" asp-route-date="@ViewBag.PreviousDay" title="Previous day" aria-label="Previous day">&larr;</a>
            <a asp-controller="Activity" asp-action="EventsByDate" asp-route-date="@ViewBag.Today" title="Today">Today</a>
            <a asp-controller="Activity" asp-action="EventsByDate" asp-route-date="@ViewBag.NextDay" title="Next day" aria-label="Next day">&rarr;</a>
        </nav>
    </form>

    <div class="blog-activity__table-wrap">
            <table class="blog-activity__table dbc-activity-table">
                <thead>
                    <tr>
                        <th scope="col">Time</th>
                        <th scope="col">Code</th>
                        <th scope="col">Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var eddi in Model)
                    {
                        <tr class="@SelectEventRowStyle(eddi)">
                            <td class="blog-activity__time" data-label="Time">
                                @eddi.Date
                            </td>
                            <td class="blog-activity__code" data-label="Code">
                                @eddi.EventCode
                            </td>
                            <td class="blog-activity__message" data-label="Message">
                                @Html.Raw(HtmlSanitizer.Sanitize(eddi.HtmlMessage))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
    </div>
</section>
